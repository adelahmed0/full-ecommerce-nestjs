PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>


JWT_SECRET=dev-secret-change
JWT_EXPIRES_IN=1d

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Ecommerce App <your-email@gmail.com>"

# Upload limits (global multipart/form-data parser)
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_MAX_FILES=10

# Telegram bot token and chat id for notifications + inbound tasks
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: public webhook URL for receiving tasks (or use npm run telegram:poll)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
